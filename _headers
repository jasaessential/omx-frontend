# Cloudflare Pages — _headers
# Block direct access to sensitive files

/.env
  X-Robots-Tag: noindex
  ! Access-Control-Allow-Origin
  Cache-Control: no-store
  Content-Type: text/plain
  X-Content-Type-Options: nosniff

/.env.example
  X-Robots-Tag: noindex
  Cache-Control: no-store

/env-config.js
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-cache, private

/env-config-sw.js
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-cache, private

/sync-env.js
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-cache, private

/workers.js
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-cache, private

# Security headers + NO-CACHE MODE for everything served by Pages.
# Owner request: no caching for now, so every page, script, style, JSON, image
# and icon is fetched fresh on each load (browser and Android TWA alike).
# A single /* rule is used because Pages serves pages at extensionless URLs
# (/cart, not /cart.html), which a /*.html rule would not match.
# `private` matters: the zone's Browser Cache TTL (4h) overrides plain
# directives but leaves private responses alone.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Cache-Control: private, no-store, max-age=0
